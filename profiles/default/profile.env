# Profile: default
#
# Everything a team needs to vary lives here: host ports (all bound on every
# interface so remote systems can test against the lab), gateway mode, and
# container storage locations. Select a profile with PROFILE=<name> in .env or
# `make up PROFILE=<name>`.

# --- host ports (external, 0.0.0.0) -----------------------------------------
# Policy (AGENTS.md rule 15): protocol data planes SUTs already speak use the
# IANA dest on the host (DNS 53, LDAP 389 / LDAPS 636, SMTP 25, TACACS+ 49 /
# 300, RADIUS 1812/1813, NFS 2049). Container listen ports are unprivileged
# and irrelevant to consumers. Management/control planes stay high.
# LabMITM is a forward proxy (SUT sets HTTP_PROXY); do not move
# LABMITM_PROXY_PORT to 443. Today's numbers below that are not native are
# residual, not a second policy — remaps are follow-on PRs. Operator escape
# (non-native host port) is allowed when preflight cannot free the IANA
# port; it is an escape, not the default.
#
# DNS data plane (UDP+TCP). Residual 10053; native dest is 53.
LABDNS_DNS_PORT=10053
# LabDNS management REST (/v1) + MCP (/mcp).
LABDNS_REST_PORT=18080
# LDAP / LDAPS data plane. Residual 3389/3636; native dests are 389/636.
LABLDAP_LDAP_PORT=3389
LABLDAP_LDAPS_PORT=3636
# LabLDAP control plane HTTPS (REST /api/v1, MCP /mcp, UI).
LABLDAP_HTTPS_PORT=8443
# MCP gateway (MCPJungle).
MCP_GATEWAY_PORT=8080
# MCPJungle gateway + registrar image tag (GHCR). This lab pins 0.4.6.
# Upstream Compose uses the same variable with default latest / latest-stdio;
# do not copy that default here, and never use latest-stdio (this lab only
# registers streamable HTTP). 0.4.6 adds --host / MCPJUNGLE_BIND_HOST
# (unset = all interfaces; do not set 127.0.0.1 — remote clients and the
# registrar need the published 0.0.0.0 bind). Omit this key to keep the
# compose default :-0.4.6; set it only to override.
MCPJUNGLE_IMAGE_TAG=0.4.6
# MCPJUNGLE_BIND_HOST=   # unset = all interfaces (required). Do not set 127.0.0.1.
# ratarmount-rs userspace NFSv3 export (deb pin 0.1.28). Residual 20490;
# native dest is 2049. NFSv4.1 is in the package (`--nfs-vers 4`); this
# lab stays on v3 — no NFS_VERS knob.
NFS_PORT=20490
# Live overlay commit interval (ratarmount --commit-overlay-interval). Writes
# land on the overlay immediately; the empty-root fixture .tar.zst is rewritten
# (last-frame splice) on this cadence and again on process exit. gzip is rejected.
# Remount after commit uses the patched SQLite sidecar (no full TAR reindex).
NFS_COMMIT_OVERLAY_INTERVAL=15m
# --- MCP compatibility (MCPJungle) ------------------------------------------
# TacLab 1.2+ pins MCP-Protocol-Version 2026-07-28 by default. The lab
# gateway speaks an older generation, so mcplab secrets turns on
# api.mcp.allow_legacy_clients in the generated baseline. Do not carry a
# local patch for this.

# TacLab (TACACS+/RADIUS) data planes — already native IANA dests.
TACLAB_LEGACY_PORT=49
TACLAB_TLS_PORT=300
TACLAB_RADIUS_ACCESS_PORT=1812
TACLAB_RADIUS_ACCT_PORT=1813
# Optional TacLab listeners (default off in the labgen baseline; host ports
# are published so a profile can enable them without a compose overlay).
TACLAB_RADIUS_RADSEC_PORT=2083
TACLAB_RADIUS_DYNAUTH_PORT=3799
# ...and its control plane (UI, REST /api/v1, MCP /mcp) — 8080 belongs to the
# gateway, so the lab moves it.
TACLAB_HTTP_PORT=18049
# LabMail receive-only mail sink (compose service name stays maildev):
# SMTP ingest + management (UI, /email, /v1, /mcp). Residual SMTP 1025;
# native dest is 25. Web 1080 stays high (management).
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080
# Web UI basic-auth user. Frozen at admin: LabMail YAML does not interpolate
# this value — changing it here without editing labmail/bootstrap.yaml 401s
# smoke. Password is generated by `mcplab secrets`.
MAILDEV_WEB_USER=admin
# LabMITM HTTP(S) intercepting forward proxy. Data plane is the SUT gun
# (HTTP_PROXY), not an IANA dest-443 service — do not move this to 443.
# v1.6.0; 1.2–1.4 knobs written in labmitm/bootstrap.yaml and default off
# (httpAuth.enabled: false; no SOCKS/inspectFrames/orig-dest).
LABMITM_PROXY_PORT=18888
# Flow-inspector UI + REST /v1 + MCP.
LABMITM_WEB_PORT=18088
# labinfo — lab service directory (MCP): tells agents the web/REST URLs of
# every service so they can direct users to the right place.
LABINFO_PORT=18090
# labgraph — LabScenario orchestrator (REST / MCP / SPA). Management plane.
LABGRAPH_PORT=18091
# LabNTP NTPv3/v4 data plane. FR / ADR 0014 default is 10123 (not a
# residual-as-design). Privileged host 123 is the operator escape when
# systemd-timesyncd is gone; SUTs that cannot set dest port cannot follow
# 10123. Management REST / MCP / SPA stay on 18123.
LABNTP_NTP_PORT=10123
LABNTP_REST_PORT=18123
# Compiled LabLDAP scenario metadata.name (POST /api/v1/reset).
LABGRAPH_LABLDAP_SCENARIO_NAME=mcp-integration-lab

# --- public address -----------------------------------------------------------
# Hostname/IP remote systems and users reach this lab on; used to build the
# URLs labinfo hands to agents, as a DNS or IP SAN on LabLDAP leaf certs
# (both modes), and as LabLDAP management Host extras
# (LABLDAP_MANAGEMENT_ALLOWED_HOSTS via compose/labldap.overlay.yaml).
# YAML cannot interpolate; extra names can go in spec.management.allowedHosts
# (no "*"). Changing this needs `mcplab secrets` (SAN) and
# `make reload APP=labldap` (container env).
LAB_PUBLIC_HOST=localhost

# --- docker network -----------------------------------------------------------
# One user-defined network (`mcplab-shared`) for all three compose projects.
# Docker's default for `docker network create` without --subnet is a /16 from
# a ~15-slot 172.17–31 pool; the old split (mcplab-shared + mcplab_default)
# wasted two of those. A /24 is enough (~12 endpoints). Override if this
# collides with a VPN. Existing leftover /16 needs `make down` then `make up`.
LAB_DOCKER_SUBNET=10.99.42.0/24

# --- security ------------------------------------------------------------------
# Dev mode is the single knob: true opens the gateway (development mode, no
# client auth), makes labinfo reveal credentials, AND reconciles secret files
# from this profile's dev-credentials.yaml (predictable lab-dev-* values).
# false (default) hardens the gateway (enterprise mode: client tokens + ACLs),
# labinfo only describes how auth works, and minting stays random. The catalog
# is inert unless LAB_DEV_MODE=true. Never enable on a shared internet-facing
# host.
# To pin the gateway mode independently, set MCPJUNGLE_MODE explicitly
# (catalog reconcile still follows LAB_DEV_MODE only).
LAB_DEV_MODE=false

# --- container storage (host paths, relative to the repo root) ---------------
# Empty-root fixture .tar.zst served over NFS. Writable: live overlay commit
# copies the compressed file and atomically replaces it (plan ~2× compressed
# size headroom during a tick).
NFS_ARCHIVE_DIR=.data/nfs
# Writable scratch space for the NFS container (archive indexes and the
# durable write overlay live here, and it is sized by whatever disk backs
# the path — give it room to work).
NFS_DATA_DIR=.data/nfs-work
